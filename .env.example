# Used from backend with: uv run --env-file ../.env ...
DATABASE_PATH=data/facility.db

# Local-only selector login. Disable before public deployment.
DEMO_LOGIN=true
# For public demo: DEMO_LOGIN=false, password >=12 chars, secret >=32 chars.
MANAGER_PASSWORD=
SESSION_SECRET=

# Change the model if needed for your account. Keys stay on the backend only.
OPENAI_API_KEY=
MODEL_ID=hackathon-chat
# Akamai workshop endpoint. For direct OpenAI, leave this blank and choose its model.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
NWS_USER_AGENT=FacilityOperationsAI/0.1 (your-contact@example.com)
AQI_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Both sources are refreshed for all saved facilities at this interval.
SCHEDULER_ENABLED=true
EVALUATION_INTERVAL_HOURS=3
EVALUATE_ON_STARTUP=false
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Explicit manager-approved SMTP delivery. Synthetic staff need a real test inbox.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
DEMO_EMAIL_TO=
